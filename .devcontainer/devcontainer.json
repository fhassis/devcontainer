{
	"name": "devcontainer",
	"dockerComposeFile": "compose.yml",
	"service": "devcontainer",
	// Profiled services to start with compose. Comment if not want them.
	"runServices": ["postgres"],
	// claude-config is external in compose.yml; create it if missing.
	"initializeCommand": "docker volume create claude-config",
	"remoteUser": "devcontainer",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"customizations": {
		"vscode": {
			// Remove the groups the project doesn't use.
			"extensions": [
				// general
				"anthropic.claude-code",
				"usernamehw.errorlens",
				"tamasfe.even-better-toml",
				"ms-azuretools.vscode-containers",
				// infra
				"redhat.ansible",
				// javascript / typescript (svelte, tailwind)
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"svelte.svelte-vscode",
				"bradlc.vscode-tailwindcss",
				// rust
				"rust-lang.rust-analyzer",
				// python
				"ms-python.python",
				"charliermarsh.ruff",
				// data / templates / viewers
				"samuelcolvin.jinjahtml",
				"GrapeCity.gc-excelviewer",
				"mechatroner.rainbow-csv"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "fish"
			}
		}
	}
}
